{
  "name": "bodylang",
  "private": true,
  "version": "0.1.0",
  "description": "A 3D human body that shows what is happening inside you, from what you tell it in plain words",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build --config site/vite.config.ts && vite build --base ./ --outDir dist/site/app --emptyOutDir && vite build --config bilan/vite.config.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && biome format && vitest run",
    "format": "biome format --write",
    "login:openai": "node tools/login-openai.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@openai/codex": "0.167.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skullet": "^0.0.3",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
